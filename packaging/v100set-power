#!/usr/bin/python3 -I
"""Root-owned helper. Accepts only a GPU UUID and a driver-supported wattage."""

import csv
import math
import os
import re
import subprocess
import sys

SMI = "/usr/bin/nvidia-smi"
ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C"}


def validate_request(args):
    if len(args) != 2 or not re.fullmatch(r"GPU-[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", args[0]):
        raise ValueError("Expected a full NVIDIA GPU UUID and a power limit in watts")
    if not re.fullmatch(r"[0-9]{1,4}(?:\.[0-9]{1,3})?", args[1]):
        raise ValueError("Invalid power limit")
    value = float(args[1])
    if not math.isfinite(value) or value <= 0:
        raise ValueError("Invalid power limit")
    return args[0], value


def run(*args):
    result = subprocess.run([SMI, *args], capture_output=True, text=True,
                            timeout=8, env=ENV, cwd="/", check=False)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "NVIDIA command failed")
    return result.stdout.strip()


def set_limit(args):
    uuid, watts = validate_request(args)
    rows = list(csv.reader(run("-i", uuid, "--query-gpu=uuid,power.min_limit,power.max_limit",
                              "--format=csv,noheader,nounits").splitlines()))
    if len(rows) != 1 or len(rows[0]) != 3 or rows[0][0].strip() != uuid:
        raise ValueError("GPU identity could not be verified")
    minimum, maximum = (float(v.strip()) for v in rows[0][1:])
    if not all(math.isfinite(v) for v in (minimum, maximum)) or not 0 < minimum <= watts <= maximum:
        raise ValueError("Requested power limit is outside the GPU's supported range")
    run("-i", uuid, "-pl", str(watts))
    actual = float(run("-i", uuid, "--query-gpu=power.limit", "--format=csv,noheader,nounits"))
    if not math.isfinite(actual) or abs(actual - watts) > 0.1:
        raise RuntimeError("NVIDIA did not confirm the requested power limit")
    return actual


def set_clock(args):
    if len(args) != 3 or args[1] != "clock":
        raise ValueError("Expected UUID clock MHz|auto")
    uuid, _ = validate_request([args[0], "1"])
    value = args[2]
    if value != "auto" and not re.fullmatch(r"[0-9]{1,4}", value):
        raise ValueError("Invalid GPU clock")
    rows = list(csv.reader(run("-i", uuid, "--query-gpu=uuid,name", "--format=csv,noheader,nounits").splitlines()))
    if len(rows) != 1 or len(rows[0]) != 2 or rows[0][0].strip() != uuid or not re.search(r"\bV100S?\b", rows[0][1]):
        raise ValueError("Clock control requires a verified V100 GPU")
    if value == "auto":
        run("-i", uuid, "-rgc")
        return "auto"
    pairs = [(int(m.strip()), int(c.strip())) for m, c in csv.reader(run("-i", uuid, "--query-supported-clocks=memory,graphics", "--format=csv,noheader,nounits").splitlines())]
    memory = max(m for m, _ in pairs)
    clocks = sorted({c for m, c in pairs if m == memory})
    if int(value) not in clocks:
        raise ValueError("Clock is not in the GPU's supported list")
    # A range preserves dynamic clocking below the requested ceiling.
    run("-i", uuid, "-lgc", f"{clocks[0]},{int(value)}")
    # Command success acknowledges the policy, not an instantaneous MHz reading.
    return str(int(value))


if __name__ == "__main__":
    try:
        if os.geteuid() != 0:
            raise PermissionError("Administrator installation is required")
        args = sys.argv[1:]
        print(set_clock(args) if len(args) == 3 else set_limit(args))
    except (ValueError, RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
